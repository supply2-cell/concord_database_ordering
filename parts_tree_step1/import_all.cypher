// Таксономія вузлів запчастин. Ідемпотентно (MERGE).
CREATE CONSTRAINT part_group_id IF NOT EXISTS FOR (g:PartGroup) REQUIRE g.id IS UNIQUE;
CREATE CONSTRAINT vehicle_type_code IF NOT EXISTS FOR (v:VehicleType) REQUIRE v.code IS UNIQUE;
MERGE (v:VehicleType {code:'TRC'}) SET v.name_ua='Тягач сідельний';
MERGE (v:VehicleType {code:'RGD'}) SET v.name_ua='Вантажівка з жорсткою рамою';
MERGE (v:VehicleType {code:'TRL'}) SET v.name_ua='Причіп дишловий';
MERGE (v:VehicleType {code:'SMT'}) SET v.name_ua='Напівпричіп';
MERGE (g:PartGroup {id:'ENG'}) SET g.code='ENG', g.name_ua='Двигун', g.name_en='Engine', g.level=1, g.kind='part';
MERGE (g:PartGroup {id:'ENG.BLK'}) SET g.code='BLK', g.name_ua='Блок циліндрів і КШМ', g.name_en='Cylinder block & crank train', g.level=2, g.kind='part';
MERGE (g:PartGroup {id:'ENG.BLK.BLOCK'}) SET g.code='BLOCK', g.name_ua='Блок циліндрів', g.name_en='Cylinder block', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.BLK.LINER'}) SET g.code='LINER', g.name_ua='Гільза циліндра', g.name_en='Cylinder liner', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.BLK.PISTON'}) SET g.code='PISTON', g.name_ua='Поршень з кільцями', g.name_en='Piston with rings', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.BLK.CONROD'}) SET g.code='CONROD', g.name_ua='Шатун', g.name_en='Connecting rod', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.BLK.CRANK'}) SET g.code='CRANK', g.name_ua='Колінчастий вал', g.name_en='Crankshaft', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.BLK.BEAR'}) SET g.code='BEAR', g.name_ua='Вкладиші корінні / шатунні', g.name_en='Main / con-rod bearings', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.BLK.FLYWH'}) SET g.code='FLYWH', g.name_ua='Маховик', g.name_en='Flywheel', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.BLK.DAMP'}) SET g.code='DAMP', g.name_ua='Гаситель крутильних коливань', g.name_en='Vibration damper', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.BLK.OILPAN'}) SET g.code='OILPAN', g.name_ua='Піддон картера', g.name_en='Oil pan', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.BLK.MOUNT'}) SET g.code='MOUNT', g.name_ua='Опора двигуна', g.name_en='Engine mount', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.BLK.MOUNT.RK'}) SET g.code='RK', g.name_ua='Ремкомплект опор двигуна', g.name_en='Engine mount kit', g.level=4, g.kind='repkit', g:RepairKit;
MERGE (g:PartGroup {id:'ENG.BLK.RK'}) SET g.code='RK', g.name_ua='Ремкомплект двигуна (ЦПГ, прокладки)', g.name_en='Engine overhaul kit', g.level=3, g.kind='repkit', g:RepairKit;
MERGE (g:PartGroup {id:'ENG.HEAD'}) SET g.code='HEAD', g.name_ua='Головка блоку і ГРМ', g.name_en='Cylinder head & valvetrain', g.level=2, g.kind='part';
MERGE (g:PartGroup {id:'ENG.HEAD.HEAD'}) SET g.code='HEAD', g.name_ua='ГБЦ', g.name_en='Cylinder head', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.HEAD.HEAD.RK'}) SET g.code='RK', g.name_ua='Ремкомплект ГБЦ (прокладки)', g.name_en='Cylinder head gasket set', g.level=4, g.kind='repkit', g:RepairKit;
MERGE (g:PartGroup {id:'ENG.HEAD.GASKET'}) SET g.code='GASKET', g.name_ua='Прокладка ГБЦ', g.name_en='Head gasket', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.HEAD.VALVE'}) SET g.code='VALVE', g.name_ua='Клапани, сідла, напрямні', g.name_en='Valves, seats, guides', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.HEAD.CAM'}) SET g.code='CAM', g.name_ua='Розподільний вал', g.name_en='Camshaft', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.HEAD.ROCK'}) SET g.code='ROCK', g.name_ua='Коромисла, штовхачі', g.name_en='Rocker arms, pushrods', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.HEAD.TIMING'}) SET g.code='TIMING', g.name_ua='Шестерні / ланцюг ГРМ', g.name_en='Timing gears / chain', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.HEAD.VCOV'}) SET g.code='VCOV', g.name_ua='Кришка клапанів', g.name_en='Valve cover', g.level=3, g.kind='part';
MERGE (g:PartGroup {id:'ENG.LUB'}) SET g.code='LUB', g.name_ua='Система змащення', g.name_en='Lubrication', g.level=2, g.kind='part';
