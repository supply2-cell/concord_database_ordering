CREATE CONSTRAINT manufacturer_id IF NOT EXISTS FOR (m:Manufacturer) REQUIRE m.id IS UNIQUE;
CREATE CONSTRAINT vmodel_id IF NOT EXISTS FOR (m:VehicleModel) REQUIRE m.id IS UNIQUE;
CREATE CONSTRAINT engine_id IF NOT EXISTS FOR (e:Engine) REQUIRE e.id IS UNIQUE;
MERGE (v:VehicleType {code:'TRC'}) SET v.name_ua='Тягач сідельний';
MERGE (v:VehicleType {code:'RGD'}) SET v.name_ua='Вантажівка з жорсткою рамою';
MERGE (v:VehicleType {code:'LCV'}) SET v.name_ua='Легкий вантажний до 3,5 т';
